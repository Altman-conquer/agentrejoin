{
  // Production build typecheck. Specs are excluded because they are never
  // shipped and may reach across packages for contract checks (e.g.
  // machinesRoutes.spec.ts imports agentrejoin-app source), which is not available
  // in the server-only Docker builder stage.
  "extends": "./tsconfig.json",
  "exclude": ["sources/**/*.spec.ts", "sources/**/*.test.ts"]
}
