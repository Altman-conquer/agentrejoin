# AgentRejoin CLI Development Environment
#
# This file is for direnv users who want automatic environment switching
# when entering this directory.
#
# Setup:
#   1. Install direnv: https://direnv.net/
#   2. Copy this file: cp .envrc.example .envrc
#   3. Run: direnv allow
#
# The .envrc file is gitignored, so each developer can customize it.

export AGENTREJOIN_HOME_DIR="$HOME/.agentrejoin-dev"
export AGENTREJOIN_VARIANT="dev"
export AGENTREJOIN_SERVER_URL="${AGENTREJOIN_SERVER_URL:-https://agentrejoin.zhandj.com}"

echo "🔧 DEV environment activated (data: $AGENTREJOIN_HOME_DIR)"
